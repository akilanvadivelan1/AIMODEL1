{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniDesk",
  "version": "0.1.0",
  "identifier": "com.omnidesk.app",
  "build": {
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OmniDesk",
        "label": "main",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "category": "Productivity",
    "shortDescription": "Your personal AI desk",
    "longDescription": "OmniDesk is a personal AI assistant that writes in your voice and is one shortcut away.",
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
