# Copy this file to .env for local use. Never commit the real .env file.

# Required in production. Use long random values.
#   SERVER_SECRET:  openssl rand -hex 32
#   ENCRYPTION_KEY: openssl rand -hex 32   (must decode to exactly 32 bytes)
SERVER_SECRET=
ENCRYPTION_KEY=

# Where the SQLite database file lives. Needs a persistent disk in production.
DATA_DIR=./data

PORT=8787

# Set to 1 when running behind a proxy such as Render, Fly, or Railway.
TRUST_PROXY=0

# Email delivery for sign-in codes (https://resend.com). Required in production.
# Without it, codes are printed to the server console for local testing.
RESEND_API_KEY=
MAIL_FROM=OmniDesk <onboarding@resend.dev>

# Optional. Enables "Continue with Google" (an OAuth Web client ID).
GOOGLE_CLIENT_ID=

# Optional. Extra web origins allowed to call the API, separated by commas.
ALLOWED_ORIGINS=
