# For running on your own computer. Copy to .env (never commit that file).
# Make each secret with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVER_SECRET=
ENCRYPTION_KEY=

# Prints sign-in codes in the terminal instead of emailing them. Local use only.
DEV_LOG_CODES=1

PORT=8787
DATA_DIR=./data

# Optional
GOOGLE_CLIENT_ID=
RESEND_API_KEY=
MAIL_FROM=OmniDesk <onboarding@resend.dev>
ALLOWED_ORIGINS=
